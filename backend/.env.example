# ===== Flask Core =====
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# ===== Database =====
# Local example: postgresql://postgres:postgres@localhost:5432/printflow
# Supabase/Neon/Render: provided connection string from your provider
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printflow

# ===== CORS =====
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ===== File Storage =====
# STORAGE_PROVIDER: "local" (dev only, NOT for production), "s3" (works for AWS S3,
# Supabase Storage S3-compatible endpoint, Cloudinary via S3 shim, or any S3-compatible service)
STORAGE_PROVIDER=local
STORAGE_BUCKET=printflow-documents
# STORAGE_URL is the S3-compatible endpoint (e.g. https://xxxx.supabase.co/storage/v1/s3)
STORAGE_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Local storage folder (only used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./storage_local

# ===== Upload Limits =====
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,webp,txt

# ===== Initial Admin Account =====
# Used only once, on first startup, to seed the admin account if none exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@printflow.local
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# ===== Rate Limiting =====
RATE_LIMIT_UPLOAD=10 per hour
RATE_LIMIT_LOGIN=5 per minute
